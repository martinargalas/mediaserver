# ============================================================
# Copy this file to .env and fill in your values.
# .env is excluded from git and must never be committed.
# ============================================================

# Base path to the MediaServer folder (no trailing slash)
MEDIA_BASE_PATH=/your/path/to/MediaServer

# User and group for linuxserver.io containers
PUID=501
PGID=20

# ------------------------------------------------------------
# VPN — Gluetun / Surfshark
# ------------------------------------------------------------
OPENVPN_USER=your_vpn_username
OPENVPN_PASSWORD=your_vpn_password

# ------------------------------------------------------------
# qBittorrent WebUI
# Used in:  docker-compose.yaml (QBT_USERNAME / QBT_PASSWORD)
# Note:     qbittorrent/qBittorrent/qBittorrent.conf also stores
#           a PBKDF2 password hash — regenerated on first login
# ------------------------------------------------------------
QBT_USERNAME=your_qbittorrent_username
QBT_PASSWORD=your_qbittorrent_password

# ------------------------------------------------------------
# Bazarr
# Used in:  bazarr/config/config.yaml
# ------------------------------------------------------------
BAZARR_API_KEY=your_bazarr_api_key                  # auth.apikey
BAZARR_FLASK_SECRET_KEY=your_flask_secret_key        # general.flask_secret_key

# OpenSubtitles.com account
OPENSUBTITLESCOM_USERNAME=your_username              # opensubtitlescom.username
OPENSUBTITLESCOM_PASSWORD=your_password              # opensubtitlescom.password

# Titulky.com account
TITULKY_USERNAME=your_username                       # titulky.username
TITULKY_PASSWORD=your_password                       # titulky.password

# Plex
PLEX_TOKEN=your_plex_token                           # plex.token
PLEX_EMAIL=your_plex_email                           # plex.email
PLEX_USERNAME=your_plex_username                     # plex.username
PLEX_USER_ID=your_plex_user_id                       # plex.user_id
PLEX_CLIENT_IDENTIFIER=your_plex_client_identifier   # plex.client_identifier
PLEX_ENCRYPTION_KEY=your_plex_encryption_key         # plex.encryption_key

# ------------------------------------------------------------
# Radarr
# Used in:  radarr/config.xml → <ApiKey>
#           bazarr/config/config.yaml → radarr.apikey
#           seerr/settings.json → radarr[].apiKey
# ------------------------------------------------------------
RADARR_API_KEY=your_radarr_api_key

# ------------------------------------------------------------
# Sonarr
# Used in:  sonarr/config.xml → <ApiKey>
#           bazarr/config/config.yaml → sonarr.apikey
#           seerr/settings.json → sonarr[].apiKey
# ------------------------------------------------------------
SONARR_API_KEY=your_sonarr_api_key

# ------------------------------------------------------------
# Lidarr
# Used in:  lidarr/config.xml → <ApiKey>
# ------------------------------------------------------------
LIDARR_API_KEY=your_lidarr_api_key

# ------------------------------------------------------------
# Prowlarr
# Used in:  prowlarr/config.xml → <ApiKey>
# ------------------------------------------------------------
PROWLARR_API_KEY=your_prowlarr_api_key

# ------------------------------------------------------------
# Jackett
# Used in:  jackett/Jackett/ServerConfig.json
# ------------------------------------------------------------
JACKETT_API_KEY=your_jackett_api_key
JACKETT_INSTANCE_ID=your_jackett_instance_id

# ------------------------------------------------------------
# SABnzbd
# Used in:  sabnzbd/sabnzbd.ini
# ------------------------------------------------------------
SABNZBD_USERNAME=your_sabnzbd_username
SABNZBD_PASSWORD=your_sabnzbd_password
SABNZBD_API_KEY=your_sabnzbd_api_key
SABNZBD_NZB_KEY=your_sabnzbd_nzb_key

# Usenet server credentials (eu.thundernews.com)
USENET_USERNAME=your_usenet_username
USENET_PASSWORD=your_usenet_password

# ------------------------------------------------------------
# Seerr
# Used in:  seerr/settings.json
# ------------------------------------------------------------
SEERR_API_KEY=your_seerr_api_key                     # main.apiKey
SEERR_CLIENT_ID=your_seerr_client_id                 # clientId
VAPID_PRIVATE_KEY=your_vapid_private_key             # vapidPrivate
VAPID_PUBLIC_KEY=your_vapid_public_key               # vapidPublic
PLEX_MACHINE_ID=your_plex_machine_id                 # plex.machineId
WEBHOOK_URL=your_webhook_url                         # notifications.agents.webhook.options.webhookUrl
